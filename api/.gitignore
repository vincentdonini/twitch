# Vendor folder (dependencies are managed via composer.lock)
/vendor/

# Var folder
/var/

# Sensitive configuration files
/.env
/.env.local
/.env.*.local

# Files generated by Composer
/composer.phar

# Files generated by Symfony Flex
/.symfony/

# Files specific to IDEs and the operating system
# macOS
.DS_Store
.AppleDouble
.LSOverride

# JetBrains (PhpStorm)
/.idea/
/*.iml

# VS Code
/.vscode/

# Deployment-specific files
/deploy/
/docker-compose.override.yml

# Symfony/framework-bundle
/.env.local.php
/config/secrets/prod/prod.decrypt.private.php
/public/bundles/

# Lexik/jwt-authentication-bundle
/config/jwt/*.pem
